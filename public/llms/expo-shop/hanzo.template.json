    "uiComponents": [
      "src/components/",
      "src/pages/",
      "src/App.tsx"
    ],
    "stylingTokens": [
      "src/styles/",
      "index.css"
    ],
    "preserveDoNotBreak": [
      "vite.config.ts",
      "package.json"
    ]
  },
  "blocks": [
    "hero-section",
    "feature-grid",
    "cta-banner",
    "responsive-footer",
    "product-grid",
    "cart",
    "tab-badge"
  ],
  "params": {
    "brandName": "Hanzo Shop",
    "tagline": "Mobile commerce",
    "hanzoApiKey": "hz_live_your_api_key",
    "hanzoAiModel": "zen4",
    "hanzoAnalyticsId": "hz_ins_expo-shop",
