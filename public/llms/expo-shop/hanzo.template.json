{
  "seed": "expo-shop",
  "name": "Hanzo Shop",
  "slug": "hanzo-shop",
  "framework": "Expo SDK 54 + expo-router 6",
  "category": "Mobile App",
  "repo": "https://github.com/hanzo-apps/expo-shop",
  "llmMd": "https://gallery.hanzo.ai/llms/expo-shop/LLM.md",
  "hotspots": {
    "copyData": [
      "src/data/",
      "src/constants/",
      "index.html"
