  },
  "platform": {
    "outDir": "dist",
    "deployUrl": "https://platform.hanzo.ai/new?repo=https%3A%2F%2Fgithub.com%2Fhanzo-apps%2Fexpo-shop&template=expo-shop&name=hanzo-shop",
    "studioUrl": "https://hanzo.app/new?template=https%3A%2F%2Fgithub.com%2Fhanzo-apps%2Fexpo-shop&seed=expo-shop",
    "hanzoEditUrl": "https://hanzo.ai/chat?template=expo-shop&name=hanzo-shop"
