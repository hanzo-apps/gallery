  "cloud": {
    "aiGateway": "https://api.hanzo.ai/v1",
    "defaultModel": "zen4",
    "analyticsId": "hz_ins_fernline",
    "insightsUrl": "https://analytics.hanzo.ai/projects/fernline-ops",
    "apiKeysUrl": "https://console.hanzo.ai/keys",
