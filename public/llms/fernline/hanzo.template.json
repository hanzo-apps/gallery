  },
  "platform": {
    "outDir": "out",
    "deployUrl": "https://platform.hanzo.ai/new?repo=https%3A%2F%2Fgithub.com%2Fhanzo-apps%2Ftemplate-fernline&template=fernline&name=fernline-ops",
